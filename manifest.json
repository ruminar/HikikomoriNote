{
  "manifest_version": 3,
  "name": "ひきこもりnote",
  "version": "0.1.0",
  "description": "枠を超えたら落選したので、殻を作りました。noteのホームを自分用に整える非公式拡張です。",
  "permissions": ["storage"],
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://note.com/*"],
      "js": ["src/common.js", "src/platform/browser-api.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
